# Analisis estatico. Hito 5 de la auditoria del 24/08 (E-01, segunda parte).
#
# Por que existe: 35.100 lineas de PHP sin red. El diagnostico lo sostenia por
# argumento, y la fase 2 lo demostro --N-02: tres herramientas rotas en silencio
# durante cuatro dias, todas por la misma migracion, porque nada automatizado
# las corria--. Este es el hito que mas hallazgos FUTUROS previene, que es otra
# cosa que cerrar los pasados.
includes:
    - vendor/larastan/larastan/extension.neon
    # La deuda que ya habia, congelada. NO es «ya esta arreglado»: es «esto se
    # queda quieto y lo nuevo no se suma». Empezo con 268 errores y solo deberia
    # bajar; si un cambio la hace crecer, se ha metido deuda nueva y el CI no lo
    # ve, porque la linea base es un archivo que se regenera a mano. Antes de
    # regenerarla, mirar por que crecio.
    #
    # Casi todo son propiedades magicas de Eloquent que PHPStan no puede
    # adivinar sin anotar los modelos. La forma de vaciarla es ir poniendo
    # `@property` en los modelos, que ademas los documenta.
    - phpstan-baseline.neon

parameters:
    paths:
        - app
        - database
        - tests

    # Nivel 5 y no mas, a proposito. Es donde PHPStan ya comprueba los tipos de
    # los argumentos --que es de donde salen los errores que de verdad revientan
    # en produccion-- sin exigir todavia genericos anotados en cada coleccion de
    # Eloquent, que en un proyecto Laravel es la mayor parte del ruido y muy
    # poca de la seguridad. Subir a 6 es una decision aparte y con su propia
    # sesion: el informe pedia 5.
    level: 5

    # De donde saca Larastan las columnas de cada modelo. Las LEE de las
    # migraciones de Laravel, y desde el paso a PostgreSQL el esquema vive en
    # un guion SQL (`database/sql/postgres/01-esquema.sql`) que Larastan no
    # entiende. Las migraciones de MariaDB archivadas describen las mismas
    # columnas, y aqui solo se leen: no se ejecutan. Lo que se anadio por SQL
    # (`institucion_id`, `institucion_externa_id`) sigue pidiendo su
    # `@property` en el modelo, como ya pedia en el paso 1.
    databaseMigrationsPath:
        - database/migrations
        - database/historico-mariadb/migrations

    # Los guiones de database/ son ejecutables sueltos, no clases: corren con
    # `php database/verificacion_esquema.php` y viven fuera del autoload de
    # Composer. `require` de un archivo que devuelve un PDO es un patron que
    # PHPStan no puede seguir sin ayuda, y anotarlo no compraria nada: lo que
    # verifica de verdad que esos guiones sirven es correrlos, y eso ya lo hace
    # el CI desde este mismo hito.
    excludePaths:
        # DemoSeeder NO se analiza, y esto costo una ejecucion de CI en rojo.
        #
        # Esta en .gitignore --siembra cuentas con contrasena conocida-- asi que
        # existe en esta maquina y NO existe en el servidor de integracion. La
        # linea base se genero aqui, con el archivo delante, y quedaron dentro
        # sus errores; alla PHPStan encontro entradas que apuntaban a un archivo
        # inexistente y se nego a seguir. Verde en local, rojo en CI, con el
        # mismo commit.
        #
        # Va como PATRON (`*/`) y no como ruta literal a proposito: una ruta
        # literal que no existe es tambien un error para PHPStan, asi que
        # excluirlo por su nombre exacto habria cambiado un fallo por otro. Un
        # patron que no casa con nada no molesta.
        #
        # La leccion, que es la de siempre en este proyecto: lo que solo existe
        # en esta maquina no puede acabar dentro de un archivo que si se sube.
        - */database/seeders/DemoSeeder.php
        - database/conexion_verificacion.php
        - database/verificacion_concurrencia.php
        - database/verificacion_concurrencia_a.php
        - database/verificacion_esquema.php
        # El esquema de MariaDB, archivado al pasar a PostgreSQL: ya no se
        # ejecuta, y sus migraciones hablan con un motor que no esta.
        - database/historico-mariadb
        # Los dos guiones del paso a PostgreSQL: ejecutables sueltos, como los
        # de arriba. Lo que dice que sirven es correrlos.
        - database/copiar_a_postgres.php
        - database/comparar_motores.php
