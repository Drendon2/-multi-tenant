# =============================================================================
# PLANTILLA PARA EL SERVIDOR. No es la de desarrollo — esa es `.env.example`.
# =============================================================================
#
# Cópiala como `.env` en el servidor y rellena lo marcado con «CAMBIAR».
#
# Las cuatro líneas que de verdad importan son APP_ENV, APP_DEBUG, LOG_LEVEL y
# SESSION_SECURE_COOKIE. Con `APP_DEBUG=true` en un servidor, cualquiera que
# provoque un error 500 recibe la página de depuración de Laravel: traza
# completa, credenciales de la base y el contenido de las consultas — que aquí
# incluye nombres, teléfonos y documentos de identidad de estudiantes menores de
# edad. No es un detalle de configuración, es una filtración.
#
# APP_ENV=production hace además otra cosa: es lo único que impide que
# `php artisan simular` siembre 300 cuentas de prueba con contraseña conocida.

APP_NAME="Casa de la Cultura"
APP_ENV=production
APP_DEBUG=false

# Se genera EN EL SERVIDOR con `php artisan key:generate`. No se copia la de
# desarrollo: es la que cifra las cookies y las sesiones de la gente real.
APP_KEY=

# Con el https puesto. La aplicación fuerza el esquema en producción porque en
# hosting compartido el SSL termina antes de PHP, pero esta variable es la que
# usan los enlaces de los correos y los redirectos absolutos.
APP_URL=https://CAMBIAR.example.co

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# De la zona horaria dependen dos reglas de negocio: si un grupo ya tiene clase
# registrada hoy, y el plazo de 48 horas para confirmarla. Ajústala antes de
# abrir matrículas si la institución no está en este huso.
APP_TIMEZONE=America/Bogota

APP_MAINTENANCE_DRIVER=file

# 12 es un equilibrio razonable en hosting compartido. Subirlo endurece las
# contraseñas y encarece cada inicio de sesión.
BCRYPT_ROUNDS=12

# `error` y no `debug`: un log en nivel debug escribe cada consulta, y en un
# plan compartido eso llena la cuota de disco y deja rastro de datos personales
# en un archivo que nadie vigila. `daily` los rota y no crece sin fin.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# PostgreSQL 18 o superior: el esquema usa un cotejo ICU que solo desde la 18
# admite LIKE (ver database/sql/postgres/01-esquema.sql y POSTGRES.md).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=CAMBIAR
DB_USERNAME=CAMBIAR
DB_PASSWORD=CAMBIAR

# La institución de quien llega sin sesión y sin token (login, inscripción,
# política de datos). Mientras no haya enrutamiento por dominio, las páginas
# públicas son de esta. Ver MULTI-INSTITUCION.md.
INSTITUCION_POR_DEFECTO=1

# La sesión en FICHERO y no en la base de datos, decidido el 08/09/2026 con el
# dato delante. En hosting compartido el motor rechaza la conexión en ráfagas
# —`[2002] Operation not permitted`, medido en producción— y con la sesión en la
# base eso tumba hasta la pantalla de entrar, que no necesita ningún dato:
# `/entrar` hace 4 consultas y 3 son de sesión. En fichero, un hipo del motor ya
# no impide entrar ni pintar las pantallas públicas, y cada petición del sistema
# se ahorra dos consultas.
#
# OJO al cambiarlo en una instalación YA EN USO: cambiar de driver invalida las
# sesiones abiertas y todo el mundo tiene que volver a entrar una vez. Por eso
# aquí nace en fichero, que es gratis, en vez de migrarse después.
SESSION_DRIVER=file

# La cookie de sesión, solo por HTTPS. Sin esto Laravel la manda también por
# http plano y basta una petición a http:// para que viaje en claro.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# La caché en fichero por la misma razón que la sesión: no dependa de la base el
# arranque de cada pantalla. Nada de lo que se cachea aquí se comparte entre
# procesos, así que el fichero cubre el caso entero.
CACHE_STORE=file

# ---------------------------------------------------------------------------
# Correo
# ---------------------------------------------------------------------------
#
# El sistema manda UN solo correo: el enlace para restablecer la contraseña
# («Olvidé mi contraseña», desde la pantalla de entrar). Nada más — no hay
# avisos de matrícula ni notificaciones de ningún tipo, y eso sigue siendo así.
#
# CON `log` LA FUNCIÓN NO FUNCIONA, y no avisa: el correo se escribe en
# `storage/logs` y la persona ve la misma pantalla tranquilizadora de siempre,
# porque esa pantalla contesta lo mismo pase lo que pase (para no delatar quién
# tiene cuenta). Así que si quieres que la recuperación sirva, esto tiene que
# ser `smtp`.
#
# Los valores de abajo son los de un buzón de Hostinger. `MAIL_USERNAME` es la
# dirección entera y `MAIL_PASSWORD` la del buzón, no la del panel.
#
# Puerto 465 con `smtps` (SSL directo). El 587 con `MAIL_SCHEME=smtp` también
# sirve; se elige el 465 porque algunos hostings compartidos filtran el 587 de
# salida.
#
# OJO CON LA CUOTA: un plan de correo gratuito tiene un tope de envíos por hora
# y por día. Para esto sobra —son enlaces sueltos, no un boletín— pero si algún
# día se manda algo masivo desde aquí, se agota y deja sin enlace a quien lo
# necesite.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=CAMBIAR@example.co
MAIL_PASSWORD=CAMBIAR
MAIL_FROM_ADDRESS="CAMBIAR@example.co"
MAIL_FROM_NAME="${APP_NAME}"

# Cuánto se espera al servidor de correo. El envío va SIN cola —en el hosting no
# corre ningún trabajador— así que quien pulsa el botón espera esto. Sin tope, un
# SMTP que no responde se lo come el CDN a los ~60 s y devuelve su 504, que no
# dice de qué va. El porqué entero está en `config/mail.php`.
MAIL_TIMEOUT=10
